# Dependencies — installed fresh inside the image
node_modules
*/node_modules

# Build output — rebuilt inside the image
frontend/dist

# Git
.git
.gitignore

# Environment files — never bake secrets into images
.env
.env.*
!.env.example

# Test artefacts
test-results
reports
coverage

# Terraform state
terraform/.terraform
terraform/tfplan
terraform/*.tfstate
terraform/*.tfstate.backup

# Editor / OS
.DS_Store
.vscode
*.swp
*.swo

# CI config — not needed at runtime
.github
